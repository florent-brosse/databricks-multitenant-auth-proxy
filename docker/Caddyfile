# Caddy — production-grade TLS edge in front of the token-federation proxy.
#
# Caddy gives, with almost no config:
#   - HTTP/2 and HTTP/3 (h3 needs the 443/udp port published in compose)
#   - automatic certificate management
#   - HTTP->HTTPS redirect, sane security defaults, the admin API turned off
#
# TLS today: `tls internal` issues a cert from Caddy's own local CA
# (self-signed). To go to real managed certs, set TFP_SITE_ADDRESS to a public
# domain whose DNS points at this host, open 80/443, and DELETE the
# `tls internal` line — Caddy then provisions Let's Encrypt certs automatically.

{
	# No admin API surface in production.
	admin off
}

{$TFP_SITE_ADDRESS:localhost} {
	# Local self-signed CA. Remove this line to switch to Let's Encrypt
	# (requires a real public domain in TFP_SITE_ADDRESS).
	tls internal

	reverse_proxy proxy:9090 {
		# Active backend health checks against the in-proxy /healthz route.
		# Caddy pulls the backend out of rotation if it goes unhealthy.
		health_uri      /healthz
		health_interval 10s
		health_timeout  3s

		# Stream responses instead of buffering. Matters for Statement
		# Execution long-polls (wait_timeout up to ~50s) and large manifests.
		flush_interval -1

		transport http {
			# Thrift (Simba ODBC/JDBC) does many sequential round-trips on a
			# single keep-alive connection — keep the upstream pool warm.
			keepalive               90s
			keepalive_idle_conns    64
			dial_timeout            10s
			# Long-poll headroom: don't time out a slow /sql/statements call.
			response_header_timeout 120s
		}
	}

	# Structured access logs to stdout (captured by `docker compose logs`).
	# Swap to a Delta table via Zerobus for governed audit logs in production.
	log {
		output stdout
		format json
	}
}
