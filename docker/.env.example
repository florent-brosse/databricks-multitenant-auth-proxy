# Copy to .env and fill in:  cp .env.example .env

# Target Databricks workspace the proxy forwards every request to. Required.
TFP_DBX_WORKSPACE=https://your-workspace.cloud.databricks.com

# Public hostname Caddy serves on.
#   localhost          -> local demo; Caddy issues a self-signed cert from its
#                         internal CA (default). Clients must trust/ignore it.
#   tfp.example.com    -> a real domain pointed at this host. To get automatic
#                         Let's Encrypt certs, also remove the `tls internal`
#                         line in docker/Caddyfile.
TFP_SITE_ADDRESS=localhost
